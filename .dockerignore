# Ignore Git-related files
.git
.gitignore

# Ignore IDE and editor configuration files
.vscode/

# Ignore log files
*.log

# Ignore environment variables file
.env
.env.local
.env.development.local
.env.production.local

# Ignore Next.js build output
.next/

# Ignore node_modules in the root, as we'll manage them explicitly
# in the Dockerfile for builder and runner stages.
node_modules

# Ignore temporary files and caches
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Ignore test-related files if not needed in the image
# tests/
# .pytest_cache/

# Ignore Dockerfile itself
Dockerfile
docker-compose.yml

# Ignore any other files or directories that are not essential for the build or runtime
# For example, if you have a 'docs' folder that's not part of the app:
# docs/
